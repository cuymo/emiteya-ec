# Copia este archivo a frontend/.env.local para desarrollo. Nunca versiones .env.local.
# URL interna del backend a la que Next.js reenvía /api (mismo origen para el navegador). La ruta
# de descarga del paquete de portabilidad también la lee, al atender cada descarga. Obligatoria en
# el build y en la ejecución de producción, con el mismo valor; solo `next dev` usa este por defecto.
API_INTERNAL_URL=http://127.0.0.1:4000
