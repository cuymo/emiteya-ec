{
  "name": "facturadorsri-opensource",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Facturador electrónico open source y self-hosted para los comprobantes del SRI de Ecuador.",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "corepack pnpm -r --parallel --filter @facturador/backend --filter @facturador/frontend dev",
    "build": "corepack pnpm -r --if-present build",
    "build:verification": "node scripts/build-for-verification.ts",
    "lint": "eslint . && corepack pnpm -r --if-present lint",
    "typecheck": "tsc --noEmit -p tsconfig.json && corepack pnpm -r --if-present typecheck",
    "test": "vitest run && corepack pnpm --filter @facturador/backend test:ac04",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,yaml,yml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,yaml,yml,css}\"",
    "check:versions": "node scripts/check-versions.ts",
    "check:xsd-artifact": "corepack pnpm --filter @facturador/backend check:xsd-artifact",
    "check:ride-assets": "corepack pnpm --filter @facturador/backend check:ride-assets",
    "check:dev-start": "node scripts/check-dev-start.ts",
    "sri:egress": "node scripts/sri-egress/session.ts",
    "openapi:generate": "corepack pnpm --filter @facturador/contracts openapi:generate",
    "openapi:check": "corepack pnpm --filter @facturador/contracts openapi:check",
    "verify": "corepack pnpm format:check && corepack pnpm openspec:validate && corepack pnpm check:versions && corepack pnpm --filter @facturador/backend db:generate && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm openapi:check && corepack pnpm check:dev-start && corepack pnpm build:verification && corepack pnpm check:web-security-policy && corepack pnpm check:xsd-artifact && corepack pnpm check:ride-assets",
    "check:web-security-policy": "node --conditions=development scripts/check-web-security-policy.ts",
    "test:visual": "corepack pnpm --filter @facturador/frontend test:visual",
    "test:visual:update": "corepack pnpm --filter @facturador/frontend test:visual:update",
    "test:visual:spacing-proof": "corepack pnpm --filter @facturador/frontend test:visual:spacing-proof",
    "security:dependencies": "node scripts/check-dependency-security.ts",
    "security:secrets": "node scripts/check-secret-security.ts",
    "deployment:context": "node --conditions=development scripts/deployment/check-build-context.ts",
    "deployment:topology": "node --conditions=development scripts/deployment/check-topology.ts",
    "deployment:recovery": "node --conditions=development scripts/deployment/check-recovery.ts",
    "test:secret-rules": "vitest run --config scripts/security/vitest.gitleaks.config.ts",
    "openspec:validate": "node scripts/openspec-validate.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fission-ai/openspec": "1.14.0",
    "@types/node": "24.19.1",
    "eslint": "10.11.0",
    "playwright-core": "1.64.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
