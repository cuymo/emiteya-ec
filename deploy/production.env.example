# Plantilla de la configuración de producción (harden-deployment-proxy-and-recovery; ADR 0027). Solo
# marcadores: ningún valor sirve tal cual. Copia y completa fuera del repositorio; nunca versiones el
# resultado. docs/architecture/deployment.md explica cada variable.

# --- Variables de Docker Compose (en el entorno del shell o en un `.env` junto al despliegue) ---
# Archivo de entorno del operador, con los secretos de la aplicación de abajo.
EMITEYA_ENV_FILE=/ruta/fuera/del/repositorio/emiteya.env
# Directorio de secretos con postgres_password, certificate_master_key, tls_certificate y
# tls_private_key (legibles por el UID 1000 los que lee la API).
EMITEYA_SECRETS_DIR=/ruta/fuera/del/repositorio/secretos
# Origen HTTPS público exacto: el de Better Auth y el destino de la redirección HTTP.
PUBLIC_ORIGIN=https://facturas.ejemplo.test
# Red interna de la aplicación. Si choca con una red del host, cambia las tres a la vez:
# TRUST_PROXY de la API sigue a PROXY_APP_IP.
APP_SUBNET=172.29.247.0/24
APP_IP_RANGE=172.29.247.128/25
PROXY_APP_IP=172.29.247.10
# Puertos publicados del borde.
EDGE_HTTPS_PORT=443
EDGE_HTTP_PORT=80

# --- Contenido de EMITEYA_ENV_FILE (secretos de la aplicación) ---
# La contraseña de DATABASE_URL es la misma de secretos/postgres_password.
# Sustituye <clave> por la contraseña de PostgreSQL.
DATABASE_URL=postgresql://emiteya:<clave>@postgres:5432/emiteya
# Sustituye el marcador por uno propio de 32 caracteres o más: openssl rand -base64 32
BETTER_AUTH_SECRET=<secreto-aleatorio>
# Solo en el primer arranque, mientras la instalación no tiene empresa; retíralos después.
INITIAL_USER_EMAIL=administracion@facturas.ejemplo.test
INITIAL_USER_PASSWORD=<contrasena-larga>

# --- Fijados por deploy/compose.yaml (aquí solo como referencia; no los cambies) ---
# NODE_ENV=production
# BETTER_AUTH_URL=${PUBLIC_ORIGIN}
# TRUST_PROXY=${PROXY_APP_IP}
# API_INTERNAL_URL=http://backend:4000
# DATA_EXPORT_DIRECTORY=/var/lib/facturador/exports
# CERTIFICATE_MASTER_KEY_FILE=/run/secrets/certificate_master_key
# SRI_TRANSMISSION_ENABLED=0
