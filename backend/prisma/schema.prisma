// Esquema de la base de datos. Los modelos de Better Auth y de sus plugins los genera el CLI `auth`
// (`db:auth-schema`), que fusiona con este archivo y conserva los modelos, relaciones y `@@unique`
// propios. Los CHECK y el trigger de solo agregado viven en el SQL de las migraciones
// (docs/architecture/database.md).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                          String                        @id
  name                        String
  email                       String
  emailVerified               Boolean                       @default(false)
  image                       String?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  role                        String?
  banned                      Boolean?                      @default(false)
  banReason                   String?
  banExpires                  DateTime?
  sessions                    Session[]
  accounts                    Account[]
  members                     Member[]
  invitations                 Invitation[]
  auditActions                AuditEvent[]                  @relation("AuditActor")
  auditTargets                AuditEvent[]                  @relation("AuditTarget")
  configVersionsCreated       CompanyConfigVersion[]        @relation("ConfigVersionCreator")
  configAssetsCreated         ConfigurationAsset[]          @relation("ConfigAssetCreator")
  sequenceReservations        FiscalSequenceReservation[]   @relation("SequenceReserver")
  signingCertificatesUploaded SigningCertificate[]          @relation("SigningCertificateUploader")
  fiscalCatalogDecisions      CompanyFiscalCatalogSetting[] @relation("FiscalCatalogDecider")
  partiesCreated              Party[]                       @relation("PartyCreator")
  partiesUpdated              Party[]                       @relation("PartyUpdater")
  productsCreated             Product[]                     @relation("ProductCreator")
  productsUpdated             Product[]                     @relation("ProductUpdater")
  invoiceDraftsCreated        InvoiceDraft[]                @relation("InvoiceDraftCreator")
  invoiceDraftsUpdated        InvoiceDraft[]                @relation("InvoiceDraftUpdater")
  documentsCreated            ElectronicDocument[]          @relation("DocumentCreator")
  documentTransitions         DocumentStateTransition[]     @relation("DocumentTransitionActor")
  idempotencyRecords          IdempotencyRecord[]           @relation("IdempotencyCreator")
  jobsRequested               Job[]                         @relation("JobRequester")
  sriAttemptsInitiated        SriAttempt[]                  @relation("SriAttemptInitiator")
  documentDeliveries          DocumentDeliveryEvent[]       @relation("DocumentDeliveryActor")
  stockInitializations        StockBalance[]                @relation("StockInitializer")
  stockMovements              StockMovement[]               @relation("StockMovementActor")
  creditNoteDraftsCreated     CreditNoteDraft[]             @relation("CreditNoteDraftCreator")
  creditNoteDraftsUpdated     CreditNoteDraft[]             @relation("CreditNoteDraftUpdater")
  debitNoteDraftsCreated      DebitNoteDraft[]              @relation("DebitNoteDraftCreator")
  debitNoteDraftsUpdated      DebitNoteDraft[]              @relation("DebitNoteDraftUpdater")

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  auditEvents                AuditEvent[]
  companyConfig              CompanyConfig?
  configVersions             CompanyConfigVersion[]
  configAssets               ConfigurationAsset[]
  establishments             Establishment[]
  fiscalSequences            FiscalSequence[]
  signingCertificates        SigningCertificate[]
  signingCertificateSettings SigningCertificateSettings?
  fiscalCatalogSettings      CompanyFiscalCatalogSetting[]
  parties                    Party[]
  products                   Product[]
  invoiceDrafts              InvoiceDraft[]
  documents                  ElectronicDocument[]
  idempotencyRecords         IdempotencyRecord[]
  jobs                       Job[]
  creditNoteDrafts           CreditNoteDraft[]
  debitNoteDrafts            DebitNoteDraft[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id                   String                      @id
  organizationId       String
  organization         Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId               String
  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                 String                      @default("member")
  createdAt            DateTime
  status               String                      @default("ACTIVE")
  defaultEmissionPoint MemberDefaultEmissionPoint?

  // Una membresía por usuario y empresa (design D11).
  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// Rastro de auditoría del tenant (design D11). Solo de agregado: el trigger de la migración rechaza
// UPDATE, DELETE y TRUNCATE. Solo cambios exitosos, sin secretos ni direcciones IP.
model AuditEvent {
  id            String       @id @default(uuid())
  companyId     String       @map("company_id")
  company       Organization @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// USER, SYSTEM o TECHNICAL_ADMIN (CHECK en la migración).
  actorType     String       @map("actor_type")
  /// Solo con actor USER (CHECK en la migración).
  actorUserId   String?      @map("actor_user_id")
  actor         User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  action        String
  targetUserId  String?      @map("target_user_id")
  target        User?        @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  /// Cambios redactados: nunca contraseñas, hashes ni credenciales.
  changes       Json?
  correlationId String       @map("correlation_id")
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([companyId, occurredAt])
  @@map("audit_event")
}

// Configuración tributaria de la empresa (add-taxpayer-setup, design D2 y D4): cabecera con la
// versión vigente y el estado de la identidad tributaria. Los triggers de la migración rechazan
// borrarla, desbloquear la identidad y cambiar el RUC bloqueado.
model CompanyConfig {
  companyId           String               @id @map("company_id")
  company             Organization         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  currentVersionId    String               @map("current_version_id")
  currentVersion      Int                  @map("current_version")
  current             CompanyConfigVersion @relation("CurrentConfigVersion", fields: [companyId, currentVersionId], references: [companyId, id], onDelete: Restrict)
  /// taxIdentityLocked = no nulo. Junto con locked_ruc (CHECK en la migración).
  taxIdentityLockedAt DateTime?            @map("tax_identity_locked_at") @db.Timestamptz(3)
  lockedRuc           String?              @map("locked_ruc") @db.Char(13)
  updatedAt           DateTime             @map("updated_at") @db.Timestamptz(3)

  @@map("company_config")
}

// Versión inmutable y completa de la configuración (design D2, CTX §39). Solo de agregado.
model CompanyConfigVersion {
  id                         String              @id @default(uuid())
  companyId                  String              @map("company_id")
  company                    Organization        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  version                    Int
  ruc                        String              @db.Char(13)
  legalName                  String              @map("legal_name") @db.VarChar(300)
  tradeName                  String?             @map("trade_name") @db.VarChar(300)
  headOfficeAddress          String              @map("head_office_address") @db.VarChar(300)
  phone                      String?             @db.VarChar(30)
  email                      String?             @db.VarChar(254)
  accountingRequired         Boolean             @map("accounting_required")
  specialTaxpayerNumber      String?             @map("special_taxpayer_number") @db.VarChar(13)
  withholdingAgentResolution String?             @map("withholding_agent_resolution") @db.VarChar(8)
  largeTaxpayer              Boolean             @map("large_taxpayer")
  /// EMPRENDEDOR o NEGOCIO_POPULAR (CHECK en la migración).
  rimpeCategory              String?             @map("rimpe_category")
  providerRuc                String?             @map("provider_ruc") @db.Char(13)
  /// TEST o PRODUCTION (CHECK en la migración).
  environment                String
  logoAssetId                String?             @map("logo_asset_id")
  logoAsset                  ConfigurationAsset? @relation(fields: [companyId, logoAssetId], references: [companyId, id], onDelete: Restrict)
  createdAt                  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById                String              @map("created_by")
  createdBy                  User                @relation("ConfigVersionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  headOf                     CompanyConfig[]     @relation("CurrentConfigVersion")

  @@unique([companyId, version])
  @@unique([companyId, id])
  @@map("company_config_version")
}

// Asset inmutable de la configuración, como el logo (ADR 0017, design D5). Solo de agregado.
model ConfigurationAsset {
  id          String                 @id @default(uuid())
  companyId   String                 @map("company_id")
  company     Organization           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// LOGO (CHECK en la migración).
  kind        String
  /// Tipo detectado por el contenido (CHECK en la migración).
  mimeType    String                 @map("mime_type")
  sizeBytes   Int                    @map("size_bytes")
  sha256      String                 @db.Char(64)
  content     Bytes
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String                 @map("created_by")
  createdBy   User                   @relation("ConfigAssetCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions    CompanyConfigVersion[]

  @@unique([companyId, sha256])
  @@unique([companyId, id])
  @@map("configuration_asset")
}

// Establecimiento (design D7): código de tres dígitos único por empresa e inmutable (trigger).
model Establishment {
  id             String          @id @default(uuid())
  companyId      String          @map("company_id")
  company        Organization    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  code           String          @db.Char(3)
  address        String          @db.VarChar(300)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  emissionPoints EmissionPoint[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@map("establishment")
}

// Punto de emisión (design D7): código único por establecimiento; código y establecimiento
// inmutables (trigger). Solo tiene código y estado.
model EmissionPoint {
  id              String                       @id @default(uuid())
  companyId       String                       @map("company_id")
  establishmentId String                       @map("establishment_id")
  establishment   Establishment                @relation(fields: [companyId, establishmentId], references: [companyId, id], onDelete: Restrict)
  code            String                       @db.Char(3)
  active          Boolean                      @default(true)
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  defaults        MemberDefaultEmissionPoint[]
  sequences       FiscalSequence[]
  invoiceDrafts   InvoiceDraft[]
  creditDrafts    CreditNoteDraft[]
  debitDrafts     DebitNoteDraft[]

  @@unique([establishmentId, code])
  @@unique([companyId, id])
  // Destino de la clave compuesta de los contadores (add-fiscal-numbering, design D2).
  @@unique([companyId, establishmentId, id])
  @@map("emission_point")
}

// Punto de emisión predeterminado de una membresía (design D8): solo preselecciona (Q-23).
model MemberDefaultEmissionPoint {
  companyId       String        @map("company_id")
  userId          String        @map("user_id")
  member          Member        @relation(fields: [companyId, userId], references: [organizationId, userId], onDelete: Restrict)
  emissionPointId String        @map("emission_point_id")
  emissionPoint   EmissionPoint @relation(fields: [companyId, emissionPointId], references: [companyId, id], onDelete: Restrict)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([companyId, userId])
  @@index([companyId, emissionPointId])
  @@map("member_default_emission_point")
}

// Contador de secuenciales (add-fiscal-numbering, design D2 y D3): uno por empresa, ambiente,
// establecimiento, punto y tipo (ADR 0003). Se crea con su primera reserva o ajuste. Los CHECK y
// triggers de la migración imponen el rango, next_number > last_reserved, la clave inmutable,
// last_reserved monótono y que no se borre.
model FiscalSequence {
  id              String                      @id @default(uuid())
  companyId       String                      @map("company_id")
  company         Organization                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// TEST o PRODUCTION (CHECK en la migración).
  environment     String
  establishmentId String                      @map("establishment_id")
  emissionPointId String                      @map("emission_point_id")
  emissionPoint   EmissionPoint               @relation(fields: [companyId, establishmentId, emissionPointId], references: [companyId, establishmentId, id], onDelete: Restrict)
  /// 01, 03, 04, 05, 06 o 07 (CHECK en la migración).
  documentType    String                      @map("document_type") @db.Char(2)
  /// De 1 a 1000000000; 1000000000 es el valor interno de agotado (design D6).
  nextNumber      Int                         @map("next_number")
  lastReserved    Int?                        @map("last_reserved")
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  reservations    FiscalSequenceReservation[]

  @@unique([companyId, environment, establishmentId, emissionPointId, documentType])
  @@map("fiscal_sequence")
}

// Número reservado (design D2 y D4): la unicidad del secuencial con el ambiente (CTX §5) en la
// base de datos. Solo de agregado.
model FiscalSequenceReservation {
  id              String              @id @default(uuid())
  companyId       String              @map("company_id")
  environment     String
  establishmentId String              @map("establishment_id")
  emissionPointId String              @map("emission_point_id")
  documentType    String              @map("document_type") @db.Char(2)
  sequence        FiscalSequence      @relation(fields: [companyId, environment, establishmentId, emissionPointId, documentType], references: [companyId, environment, establishmentId, emissionPointId, documentType], onDelete: Restrict)
  sequential      Int
  reservedAt      DateTime            @default(now()) @map("reserved_at") @db.Timestamptz(3)
  reservedById    String?             @map("reserved_by")
  reservedBy      User?               @relation("SequenceReserver", fields: [reservedById], references: [id], onDelete: Restrict)
  correlationId   String              @map("correlation_id")
  document        ElectronicDocument?

  @@unique([companyId, environment, establishmentId, emissionPointId, documentType, sequential])
  @@map("fiscal_sequence_reservation")
}

// Firma electrónica (add-signing-certificate, design D2; ADR 0011). Metadatos, sin secretos: el
// P12 y su contraseña cifrados viven en signing_certificate_secret. A lo sumo una firma ACTIVE por
// empresa: active_company_id vale company_id mientras está ACTIVE y NULL al reemplazarse (UNIQUE y
// CHECK en la migración). Sin borrado: solo la transición ACTIVE -> REPLACED (trigger).
model SigningCertificate {
  id                String                    @id @default(uuid())
  companyId         String                    @map("company_id")
  company           Organization              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// ACTIVE o REPLACED (CHECK en la migración).
  status            String
  activeCompanyId   String?                   @unique @map("active_company_id")
  subject           String
  issuer            String
  serialNumber      String                    @map("serial_number")
  fingerprintSha256 String                    @map("fingerprint_sha256") @db.Char(64)
  notBefore         DateTime                  @map("not_before") @db.Timestamptz(3)
  notAfter          DateTime                  @map("not_after") @db.Timestamptz(3)
  detectedRuc       String                    @map("detected_ruc") @db.Char(13)
  keyAlgorithm      String                    @map("key_algorithm")
  keyBits           Int                       @map("key_bits")
  uploadedBy        String                    @map("uploaded_by")
  uploader          User                      @relation("SigningCertificateUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  replacedAt        DateTime?                 @map("replaced_at") @db.Timestamptz(3)
  replacedById      String?                   @map("replaced_by_id")
  replacedBy        SigningCertificate?       @relation("SigningCertificateReplacement", fields: [companyId, replacedById], references: [companyId, id], onDelete: Restrict)
  replaces          SigningCertificate[]      @relation("SigningCertificateReplacement")
  secret            SigningCertificateSecret?

  @@unique([companyId, id])
  @@map("signing_certificate")
}

// Secreto cifrado de la firma vigente (formato 1 de design D5). Sin actualización: reemplazar es
// borrarlo e insertar el de la firma nueva. El borrado es la destrucción intencional del ADR 0011.
model SigningCertificateSecret {
  certificateId      String             @id @map("certificate_id")
  companyId          String             @map("company_id")
  certificate        SigningCertificate @relation(fields: [companyId, certificateId], references: [companyId, id], onDelete: Restrict)
  formatVersion      Int                @map("format_version") @db.SmallInt
  keyVersion         String             @map("key_version")
  keyCheck           Bytes              @map("key_check")
  wrappedKey         Bytes              @map("wrapped_key")
  wrappedKeyNonce    Bytes              @map("wrapped_key_nonce")
  p12Ciphertext      Bytes              @map("p12_ciphertext")
  p12Nonce           Bytes              @map("p12_nonce")
  passwordCiphertext Bytes              @map("password_ciphertext")
  passwordNonce      Bytes              @map("password_nonce")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([companyId, certificateId])
  @@map("signing_certificate_secret")
}

// Anticipación del aviso de vencimiento por empresa (design D8): sin fila, 30 días.
model SigningCertificateSettings {
  companyId       String       @id @map("company_id")
  company         Organization @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// Entre 1 y 90 (CHECK en la migración).
  expiryAlertDays Int          @map("expiry_alert_days")
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("signing_certificate_settings")
}

// Catálogos fiscales oficiales (add-fiscal-catalogs, design D3, D4 y D14): datos normativos del
// sistema, sin empresa, que el cargador aplica al arrancar desde datasets versionados (ADR 0020).
// Ninguna fila se borra; las transiciones permitidas las guardan triggers de la migración.

// Versión aplicada de cada dataset, con su fuente, su checksum y su política de habilitación.
model FiscalCatalogDataset {
  catalogType       String               @map("catalog_type")
  version           Int
  sourceDocument    String               @map("source_document")
  sourceVersion     String               @map("source_version")
  sourcePublishedOn DateTime             @map("source_published_on") @db.Date
  sourceUrl         String               @map("source_url")
  sourceSha256      String               @map("source_sha256") @db.Char(64)
  /// NOT_ENABLEABLE, DEFAULT_ENABLED o DEFAULT_DISABLED (CHECK en la migración).
  enablementPolicy  String               @map("enablement_policy")
  checksum          String               @db.Char(64)
  loadedAt          DateTime             @default(now()) @map("loaded_at") @db.Timestamptz(3)
  entries           FiscalCatalogEntry[]

  @@id([catalogType, version])
  @@map("fiscal_catalog_dataset")
}

// Identidad estable de una entrada: (catálogo, entryKey). El código fiscal no es identidad
// (la tabla 18 de la ficha repite códigos con denominaciones distintas, design D6).
model FiscalCatalogKey {
  catalogType     String                        @map("catalog_type")
  entryKey        String                        @map("entry_key")
  code            String
  versions        FiscalCatalogEntry[]
  settings        CompanyFiscalCatalogSetting[]
  productTaxes    ProductTax[]
  invoicePayments InvoiceDraftPayment[]

  @@id([catalogType, entryKey])
  @@map("fiscal_catalog_key")
}

// Versión de una entrada: (catálogo, entryKey, effectiveFrom), sin superposición, con las columnas
// tipadas de su catálogo (design D8).
model FiscalCatalogEntry {
  id                            String               @id @default(uuid())
  catalogType                   String               @map("catalog_type")
  entryKey                      String               @map("entry_key")
  key                           FiscalCatalogKey     @relation(fields: [catalogType, entryKey], references: [catalogType, entryKey], onDelete: Restrict)
  officialLabel                 String               @map("official_label")
  effectiveFrom                 DateTime             @map("effective_from") @db.Date
  /// SOURCE_STATED o PROJECT_BASELINE (CHECK en la migración).
  effectiveFromBasis            String               @map("effective_from_basis")
  effectiveTo                   DateTime?            @map("effective_to") @db.Date
  /// OFFICIAL, OFFICIAL_REFERENCE o WITHDRAWN (CHECK en la migración).
  normativeStatus               String               @map("normative_status")
  sourceRef                     String               @map("source_ref")
  datasetVersion                Int                  @map("dataset_version")
  dataset                       FiscalCatalogDataset @relation(fields: [catalogType, datasetVersion], references: [catalogType, version], onDelete: Restrict)
  closedInDatasetVersion        Int?                 @map("closed_in_dataset_version")
  statusChangedInDatasetVersion Int?                 @map("status_changed_in_dataset_version")
  taxKind                       String?              @map("tax_kind")
  sriTaxCode                    String?              @map("sri_tax_code")
  rateKind                      String?              @map("rate_kind")
  percentage                    Decimal?             @db.Decimal
  identificationPattern         String?              @map("identification_pattern")
  identificationRule            String?              @map("identification_rule")
  reservedFor                   String?              @map("reserved_for")
  /// Catálogos de retención y de sustento (add-withholding-receipts, design D11; CHECK en la migración).
  scopeClassification           String?              @map("scope_classification")
  rateText                      String?              @map("rate_text")
  allowedSupportCodes           String[]             @map("allowed_support_codes")

  @@unique([catalogType, entryKey, effectiveFrom])
  @@map("fiscal_catalog_entry")
}

// Política de consumidor final (design D7): monto máximo e identidad canónica, por vigencia.
model ConsumerFinalPolicy {
  id                     String    @id @default(uuid())
  maxAmount              Decimal   @map("max_amount") @db.Decimal
  currency               String    @db.Char(3)
  identificationType     String    @map("identification_type")
  identification         String
  canonicalName          String    @map("canonical_name")
  effectiveFrom          DateTime  @unique @map("effective_from") @db.Date
  effectiveFromBasis     String    @map("effective_from_basis")
  effectiveTo            DateTime? @map("effective_to") @db.Date
  sourceRef              String    @map("source_ref")
  datasetVersion         Int       @map("dataset_version")
  closedInDatasetVersion Int?      @map("closed_in_dataset_version")

  @@map("consumer_final_policy")
}

// Límite de tamaño del comprobante firmado para su envío individual al SRI (add-sri-transmission,
// design D17, Q-47): política versionada con la cita de la fuente, su sección, la unidad literal y
// su interpretación exacta en bytes. Mismo patrón que la política de consumidor final.
model SriTransmissionPolicy {
  id                     String    @id @default(uuid())
  maxSignedDocumentBytes Int       @map("max_signed_document_bytes")
  sourceText             String    @map("source_text")
  sourceSection          String    @map("source_section")
  literalUnit            String    @map("literal_unit")
  interpretation         String
  effectiveFrom          DateTime  @unique @map("effective_from") @db.Date
  effectiveFromBasis     String    @map("effective_from_basis")
  effectiveTo            DateTime? @map("effective_to") @db.Date
  datasetVersion         Int       @map("dataset_version")
  closedInDatasetVersion Int?      @map("closed_in_dataset_version")

  @@map("sri_transmission_policy")
}

// Registro de esquemas XSD (design D2 y D14, ADR 0008): filas inmutables por versión
// del dataset; rige la última versión aplicada.
model SchemaRegistryEntry {
  /// Ruta lógica del archivo dentro del paquete de XSD (add-invoice-emission, design D11).
  path           String
  datasetVersion Int      @map("dataset_version")
  /// DOCUMENT o IMPORT (CHECK en la migración).
  kind           String   @default("DOCUMENT")
  documentType   String?  @map("document_type")
  version        String?
  root           String?
  file           String
  sha256         String   @db.Char(64)
  source         String
  /// Revisión de un esquema importado, como la del W3C.
  revision       String?
  /// Rutas lógicas de los esquemas que importa un esquema de documento.
  imports        String[] @default([])
  downloadedAt   DateTime @map("downloaded_at") @db.Timestamptz(3)
  supported      Boolean

  @@id([path, datasetVersion])
  @@map("schema_registry_entry")
}

// Matriz de casos especiales (ADR 0014): filas inmutables por versión del dataset.
model SpecialCaseSupport {
  annex          Int
  datasetVersion Int    @map("dataset_version")
  topic          String
  /// CORE, CONDITIONAL_ISSUER_RULE, CONDITIONAL_GO_LIVE, NOT_APPLICABLE u OUT_OF_MVP (CHECK).
  category       String
  sourceRef      String @map("source_ref")

  @@id([annex, datasetVersion])
  @@map("special_case_support")
}

// Decisión explícita de una empresa sobre una entrada habilitable (design D9). Sin fila rige la
// política por defecto del catálogo; una fila nunca copia el catálogo.
model CompanyFiscalCatalogSetting {
  companyId   String           @map("company_id")
  company     Organization     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  catalogType String           @map("catalog_type")
  entryKey    String           @map("entry_key")
  key         FiscalCatalogKey @relation(fields: [catalogType, entryKey], references: [catalogType, entryKey], onDelete: Restrict)
  enabled     Boolean
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   String           @map("updated_by")
  updater     User             @relation("FiscalCatalogDecider", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@id([companyId, catalogType, entryKey])
  @@map("company_fiscal_catalog_setting")
}

// Tercero de una empresa (add-parties-and-products, design D3 a D5): identificación única por
// empresa, tipo y número. El consumidor final es un registro del sistema (`system_record`), uno por
// empresa, inmutable y obligatorio; lo garantizan los CHECK y triggers de la migración.
model Party {
  id                   String         @id @default(uuid())
  companyId            String         @map("company_id")
  company              Organization   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  identificationType   String         @map("identification_type") @db.Char(2)
  identification       String         @db.VarChar(20)
  legalName            String         @map("legal_name") @db.VarChar(300)
  address              String?        @db.VarChar(300)
  email                String?        @db.VarChar(300)
  phone                String?        @db.VarChar(50)
  roles                String[]       @default([])
  status               String         @default("ACTIVE")
  systemRecord         String?        @map("system_record")
  version              Int            @default(1)
  searchName           String         @map("search_name")
  /// Colación C en la migración: el índice btree sirve para LIKE 'prefijo%' (design D10).
  searchIdentification String         @map("search_identification")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy            String?        @map("created_by")
  creator              User?          @relation("PartyCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy            String?        @map("updated_by")
  updater              User?          @relation("PartyUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
  invoiceDrafts        InvoiceDraft[]

  @@unique([companyId, identificationType, identification])
  // Destino de la referencia del comprador de un borrador, en la misma empresa (add-invoice-emission).
  @@unique([companyId, id])
  @@index([companyId, searchIdentification])
  @@index([companyId, status, searchName, id])
  @@map("party")
}

// Producto o servicio de una empresa (add-parties-and-products, design D6 y D9): precio unitario
// sin impuestos en `NUMERIC` sin escala fija, con el CHECK de dominio de `precioUnitario` (18
// dígitos en total, 6 decimales como máximo); código principal único por empresa.
model Product {
  id                  String                @id @default(uuid())
  companyId           String                @map("company_id")
  company             Organization          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  kind                String
  mainCode            String?               @map("main_code") @db.VarChar(25)
  auxiliaryCode       String?               @map("auxiliary_code") @db.VarChar(25)
  name                String                @db.VarChar(300)
  description         String?               @db.VarChar(1000)
  unitPrice           Decimal               @map("unit_price") @db.Decimal
  stockTracked        Boolean               @default(false) @map("stock_tracked")
  status              String                @default("ACTIVE")
  version             Int                   @default(1)
  searchName          String                @map("search_name")
  /// Colación C en la migración, como la identificación de los terceros (design D10).
  searchMainCode      String?               @map("search_main_code")
  searchAuxiliaryCode String?               @map("search_auxiliary_code")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy           String                @map("created_by")
  creator             User                  @relation("ProductCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy           String                @map("updated_by")
  updater             User                  @relation("ProductUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
  taxes               ProductTax[]
  invoiceLines        InvoiceDraftLine[]
  stock               StockBalance?
  creditLines         CreditCapacityLine[]
  returnCapacities    StockReturnCapacity[]

  @@unique([companyId, mainCode])
  @@unique([companyId, id])
  @@index([companyId, searchMainCode])
  @@index([companyId, searchAuxiliaryCode])
  @@index([companyId, status, searchName, id])
  @@map("product")
}

// Referencia de un producto a una entrada del catálogo fiscal (design D7): una por impuesto, por la
// identidad de la entrada, sin copiar ninguna tarifa.
model ProductTax {
  productId   String           @map("product_id")
  companyId   String           @map("company_id")
  product     Product          @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Restrict)
  catalogType String           @map("catalog_type")
  entryKey    String           @map("entry_key")
  key         FiscalCatalogKey @relation(fields: [catalogType, entryKey], references: [catalogType, entryKey], onDelete: Restrict)

  @@id([productId, catalogType])
  @@index([companyId, catalogType, entryKey])
  @@map("product_tax")
}

// Borrador de factura (add-invoice-emission, design D2): recurso editable previo a la emisión, sin
// secuencial ni datos fiscales. Las referencias son de la misma empresa (FK compuestas). Emitido,
// queda EMITTED con su documento y un trigger impide cambiarlo o borrarlo.
model InvoiceDraft {
  id              String                @id @default(uuid())
  companyId       String                @map("company_id")
  company         Organization          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  emissionPointId String?               @map("emission_point_id")
  emissionPoint   EmissionPoint?        @relation(fields: [companyId, emissionPointId], references: [companyId, id], onDelete: Restrict)
  buyerPartyId    String?               @map("buyer_party_id")
  buyer           Party?                @relation(fields: [companyId, buyerPartyId], references: [companyId, id], onDelete: Restrict)
  /// DRAFT o EMITTED (CHECK en la migración).
  status          String                @default("DRAFT")
  documentId      String?               @unique @map("document_id")
  document        ElectronicDocument?   @relation("DraftDocument", fields: [documentId], references: [id], onDelete: Restrict)
  version         Int                   @default(1)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String                @map("created_by")
  creator         User                  @relation("InvoiceDraftCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String                @map("updated_by")
  updater         User                  @relation("InvoiceDraftUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
  lines           InvoiceDraftLine[]
  payments        InvoiceDraftPayment[]

  @@unique([companyId, id])
  @@index([companyId, status, updatedAt])
  @@map("invoice_draft")
}

// Línea de un borrador: producto, cantidad y descuento. El precio no se guarda: la emisión toma el
// del producto y lo congela en el snapshot (design D2).
model InvoiceDraftLine {
  draftId   String       @map("draft_id")
  companyId String       @map("company_id")
  draft     InvoiceDraft @relation(fields: [companyId, draftId], references: [companyId, id], onDelete: Cascade)
  position  Int
  productId String       @map("product_id")
  product   Product      @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Restrict)
  quantity  Decimal      @db.Decimal
  discount  Decimal      @db.Decimal

  @@id([draftId, position])
  @@map("invoice_draft_line")
}

// Forma de pago de un borrador, por la identidad de su entrada del catálogo; sin importe cubre el
// importe total si es la única (design D2).
model InvoiceDraftPayment {
  draftId     String           @map("draft_id")
  companyId   String           @map("company_id")
  draft       InvoiceDraft     @relation(fields: [companyId, draftId], references: [companyId, id], onDelete: Cascade)
  position    Int
  catalogType String           @default("payment-method") @map("catalog_type")
  entryKey    String           @map("entry_key")
  method      FiscalCatalogKey @relation(fields: [catalogType, entryKey], references: [catalogType, entryKey], onDelete: Restrict)
  amount      Decimal?         @db.Decimal

  @@id([draftId, position])
  @@map("invoice_draft_payment")
}

// Comprobante electrónico (design D3; ADR 0002): existe desde RESERVED, con su snapshot inmutable,
// su secuencial confirmado y su clave de acceso. Solo pasa de RESERVED a SIGNED, y SIGNED exige su
// artefacto firmado (trigger diferido). No se borra.
model ElectronicDocument {
  id                       String                    @id @default(uuid())
  companyId                String                    @map("company_id")
  company                  Organization              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  documentType             String                    @map("document_type") @db.Char(2)
  environment              String
  establishmentId          String                    @map("establishment_id")
  emissionPointId          String                    @map("emission_point_id")
  documentNumber           String                    @map("document_number") @db.Char(17)
  sequential               Int
  reservationId            String                    @unique @map("reservation_id")
  reservation              FiscalSequenceReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  accessKey                String                    @unique @map("access_key") @db.Char(49)
  numericCode              String                    @map("numeric_code") @db.Char(8)
  issueDate                DateTime                  @map("issue_date") @db.Date
  /// RESERVED o SIGNED (CHECK en la migración).
  state                    String
  snapshot                 Json
  schemaVersion            String                    @map("schema_version")
  buyerIdentification      String                    @map("buyer_identification")
  buyerName                String                    @map("buyer_name")
  /// Copia del importe total del snapshot, con el CHECK de `importe`.
  total                    Decimal                   @db.Decimal
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy                String                    @map("created_by")
  creator                  User                      @relation("DocumentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  signedAt                 DateTime?                 @map("signed_at") @db.Timestamptz(3)
  /// Diagnóstico del último intento, separado del estado fiscal (design D10).
  lastAttemptStage         String?                   @map("last_attempt_stage")
  lastAttemptCode          String?                   @map("last_attempt_code")
  lastAttemptClass         String?                   @map("last_attempt_class")
  lastAttemptAt            DateTime?                 @map("last_attempt_at") @db.Timestamptz(3)
  /// Para XSD_INVALID, la línea y el elemento (design D10); nunca el valor ni el XML.
  lastAttemptDetail        Json?                     @map("last_attempt_detail")
  /// Autorización del SRI (add-sri-transmission, design D16): solo en AUTHORIZED e inmutable.
  authorizationNumber      String?                   @map("authorization_number") @db.Char(49)
  authorizationDate        DateTime?                 @map("authorization_date") @db.Timestamptz(3)
  authorizationEnvironment String?                   @map("authorization_environment")
  attemptCount             Int                       @default(0) @map("attempt_count")
  attemptLeaseUntil        DateTime?                 @map("attempt_lease_until") @db.Timestamptz(3)
  draft                    InvoiceDraft?             @relation("DraftDocument")
  sriAttempts              SriAttempt[]
  jobs                     Job[]
  transitions              DocumentStateTransition[]
  artifacts                DocumentArtifact[]
  idempotency              IdempotencyRecord[]
  deliveries               DocumentDeliveryEvent[]
  stockMovements           StockMovement[]
  /// add-credit-notes: borradores de nota sobre esta factura, y el borrador que emitió esta nota.
  creditDrafts             CreditNoteDraft[]         @relation("CreditNoteDraftInvoice")
  creditDraft              CreditNoteDraft?          @relation("CreditNoteDraftDocument")
  /// Capacidad acreditable y devolvible de esta factura, y las reservas de esta nota.
  creditCapacity           CreditCapacity?
  creditReservation        CreditReservation?
  returnCapacities         StockReturnCapacity[]
  returnReservations       StockReturnReservation[]
  /// add-debit-notes: borradores de nota de débito sobre esta factura, el borrador que emitió esta
  /// nota, y la factura de esta nota de débito o las notas de débito de esta factura.
  debitDrafts              DebitNoteDraft[]          @relation("DebitNoteDraftInvoice")
  debitDraft               DebitNoteDraft?           @relation("DebitNoteDraftDocument")
  debitSupport             DebitNoteSupport?         @relation("DebitNoteSupportNote")
  debitNotes               DebitNoteSupport[]        @relation("DebitNoteSupportInvoice")

  @@unique([companyId, environment, establishmentId, emissionPointId, documentType, sequential])
  @@unique([companyId, id])
  @@index([companyId, documentType, createdAt, id])
  @@index([companyId, documentNumber])
  // Bandeja (add-document-archive, design D2): orden por fecha de emisión y filtro por receptor.
  @@index([companyId, issueDate, id])
  @@index([companyId, buyerIdentification])
  @@map("electronic_document")
}

// Historial de transiciones de un comprobante (ERS RF-525): solo de agregado.
model DocumentStateTransition {
  id          String             @id @default(uuid())
  companyId   String             @map("company_id")
  documentId  String             @map("document_id")
  document    ElectronicDocument @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict)
  fromState   String?            @map("from_state")
  toState     String             @map("to_state")
  cause       String
  /// USER o SYSTEM (CHECK en la migración).
  actorType   String             @map("actor_type")
  actorUserId String?            @map("actor_user_id")
  actor       User?              @relation("DocumentTransitionActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  metadata    Json?
  occurredAt  DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([companyId, documentId, occurredAt])
  @@map("document_state_transition")
}

// Artefacto fiscal de un comprobante (ADR 0010): bytes exactos, inmutables, con su hash. Solo de
// agregado; un comprobante tiene a lo sumo un artefacto de cada tipo.
model DocumentArtifact {
  id         String                  @id @default(uuid())
  companyId  String                  @map("company_id")
  documentId String                  @map("document_id")
  document   ElectronicDocument      @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict)
  /// SIGNED_XML y AUTHORIZED_XML con application/xml, RIDE_PDF con application/pdf (CHECK en la
  /// migración).
  kind       String
  mediaType  String                  @map("media_type")
  content    Bytes
  sizeBytes  Int                     @map("size_bytes")
  sha256     String                  @db.Char(64)
  metadata   Json
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveries DocumentDeliveryEvent[]

  @@unique([documentId, kind])
  @@map("document_artifact")
}

// Entrega observable de un documento (add-document-archive, design D9; Q-24): una descarga que la
// aplicación sirvió o una solicitud de impresión del RIDE. Solo de agregado; nunca guarda bytes ni
// afirma que el documento se imprimió o llegó a su receptor.
model DocumentDeliveryEvent {
  id             String             @id @default(uuid())
  companyId      String             @map("company_id")
  documentId     String             @map("document_id")
  document       ElectronicDocument @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict)
  /// DOWNLOAD o PRINT_REQUESTED (CHECK en la migración).
  event          String
  artifactKind   String             @map("artifact_kind")
  artifact       DocumentArtifact   @relation(fields: [documentId, artifactKind], references: [documentId, kind], onDelete: Restrict)
  artifactSha256 String             @map("artifact_sha256") @db.Char(64)
  actorUserId    String             @map("actor_user_id")
  actor          User               @relation("DocumentDeliveryActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  requestId      String             @map("request_id")
  occurredAt     DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([companyId, documentId, occurredAt])
  @@map("document_delivery_event")
}

// Registro de idempotencia de la emisión (Q-30, design D8): empresa, operación y clave, con la huella
// canónica de la solicitud. Solo de agregado: no expira durante la vida fiscal del comprobante.
model IdempotencyRecord {
  companyId          String             @map("company_id")
  company            Organization       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  operation          String
  idempotencyKey     String             @map("idempotency_key") @db.VarChar(100)
  requestFingerprint String             @map("request_fingerprint") @db.Char(64)
  documentId         String             @map("document_id")
  document           ElectronicDocument @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String             @map("created_by")
  creator            User               @relation("IdempotencyCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@id([companyId, operation, idempotencyKey])
  @@map("idempotency_record")
}

// Cola durable de trabajos (ADR 0012; add-sri-transmission, design D5). Los estados del job no son
// estados fiscales. active_dedupe_key y active_sri_document_id valen su clave mientras el job está
// activo (PENDING o LEASED) y NULL al terminar: sus UNIQUE impiden dos jobs activos equivalentes y
// dos interacciones activas con el SRI por comprobante (CHECK en la migración). document_id lleva
// una FK simple: la empresa la fijan las consultas, que siempre filtran por company_id.
model Job {
  id                  String              @id @default(uuid())
  companyId           String              @map("company_id")
  company             Organization        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  type                String
  dedupeKey           String              @map("dedupe_key")
  activeDedupeKey     String?             @unique @map("active_dedupe_key")
  documentId          String?             @map("document_id")
  document            ElectronicDocument? @relation(fields: [documentId], references: [id], onDelete: Restrict)
  activeSriDocumentId String?             @unique @map("active_sri_document_id")
  payload             Json                @default("{}")
  /// PENDING, LEASED, DONE o STOPPED (CHECK en la migración).
  status              String
  scheduledAt         DateTime            @map("scheduled_at") @db.Timestamptz(3)
  nextAttemptAt       DateTime            @map("next_attempt_at") @db.Timestamptz(3)
  attemptCount        Int                 @default(0) @map("attempt_count")
  maxAttempts         Int                 @map("max_attempts")
  deadlineAt          DateTime?           @map("deadline_at") @db.Timestamptz(3)
  leaseOwner          String?             @map("lease_owner")
  leaseExpiresAt      DateTime?           @map("lease_expires_at") @db.Timestamptz(3)
  lastErrorCode       String?             @map("last_error_code")
  /// RETRYABLE, DETERMINISTIC o INTEGRITY (CHECK en la migración).
  lastErrorClass      String?             @map("last_error_class")
  lastErrorAt         DateTime?           @map("last_error_at") @db.Timestamptz(3)
  lastErrorDetail     Json?               @map("last_error_detail")
  /// AUTOMATIC o MANUAL; MANUAL exige quien lo pidió (CHECK en la migración).
  origin              String
  requestedBy         String?             @map("requested_by")
  requester           User?               @relation("JobRequester", fields: [requestedBy], references: [id], onDelete: Restrict)
  reason              String?
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt         DateTime?           @map("completed_at") @db.Timestamptz(3)
  attempts            SriAttempt[]

  @@index([status, nextAttemptAt])
  @@index([companyId, documentId])
  @@map("job")
}

// Intento con el SRI (add-sri-transmission, design D7): la evidencia de una interacción concreta,
// de solo agregado. Nunca se usa como máquina de estados.
model SriAttempt {
  id                 String             @id @default(uuid())
  companyId          String             @map("company_id")
  documentId         String             @map("document_id")
  document           ElectronicDocument @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict)
  jobId              String?            @map("job_id")
  job                Job?               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  attemptNumber      Int                @map("attempt_number")
  /// RECEPTION, AUTHORIZATION o VALIDITY (CHECK en la migración).
  operation          String
  environment        String
  endpoint           String
  origin             String
  initiatedBy        String?            @map("initiated_by")
  initiator          User?              @relation("SriAttemptInitiator", fields: [initiatedBy], references: [id], onDelete: Restrict)
  startedAt          DateTime           @map("started_at") @db.Timestamptz(3)
  headersAt          DateTime?          @map("headers_at") @db.Timestamptz(3)
  completedAt        DateTime           @map("completed_at") @db.Timestamptz(3)
  /// NOT_SENT, REQUEST_TIMEOUT, BODY_TIMEOUT, CONNECTION_LOST o RESPONSE (CHECK en la migración).
  transportOutcome   String             @map("transport_outcome")
  httpStatus         Int?               @map("http_status")
  responseHeaders    Json?              @map("response_headers")
  transportErrorCode String?            @map("transport_error_code")
  envelopeSha256     String             @map("envelope_sha256") @db.Char(64)
  envelopeSize       Int                @map("envelope_size")
  sentArtifactSha256 String?            @map("sent_artifact_sha256") @db.Char(64)
  sentArtifactSize   Int?               @map("sent_artifact_size")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  response           SriResponse?
  result             SriAttemptResult?

  @@unique([documentId, attemptNumber])
  @@unique([companyId, id])
  @@index([companyId, documentId, startedAt])
  @@map("sri_attempt")
}

// Respuesta original exacta de un intento (design D7): bytes, hash y tamaño, de solo agregado.
model SriResponse {
  attemptId   String     @id @map("attempt_id")
  companyId   String     @map("company_id")
  attempt     SriAttempt @relation(fields: [companyId, attemptId], references: [companyId, id], onDelete: Restrict)
  body        Bytes
  sizeBytes   Int        @map("size_bytes")
  sha256      String     @db.Char(64)
  contentType String?    @map("content_type")
  truncated   Boolean    @default(false)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([companyId, attemptId])
  @@map("sri_response")
}

// Clasificación de un intento (design D7 y D8): resultado y mensajes estructurados, de solo agregado.
model SriAttemptResult {
  attemptId         String     @id @map("attempt_id")
  companyId         String     @map("company_id")
  attempt           SriAttempt @relation(fields: [companyId, attemptId], references: [companyId, id], onDelete: Restrict)
  outcome           String
  messages          Json
  parsed            Json?
  classifierVersion String     @map("classifier_version")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([companyId, attemptId])
  @@map("sri_attempt_result")
}

// Inventario de un producto (add-minimal-inventory, design D2): su existencia es la inicialización.
// Guarda el saldo materializado, que siempre es el saldo después del último movimiento y la suma de
// sus variaciones (trigger diferido en la migración). No se borra.
model StockBalance {
  companyId     String          @map("company_id")
  productId     String          @map("product_id")
  product       Product         @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Restrict)
  /// Dominio `existencia` (CHECK en la migración); puede ser negativo (Q-19).
  balance       Decimal         @db.Decimal
  /// Posición del último movimiento del kárdex.
  lastPosition  Int             @map("last_position")
  initializedAt DateTime        @default(now()) @map("initialized_at") @db.Timestamptz(3)
  initializedBy String          @map("initialized_by")
  initializer   User            @relation("StockInitializer", fields: [initializedBy], references: [id], onDelete: Restrict)
  updatedAt     DateTime        @default(now()) @map("updated_at") @db.Timestamptz(3)
  movements     StockMovement[]

  @@id([companyId, productId])
  @@index([companyId, balance])
  @@map("stock_balance")
}

// Movimiento de inventario (add-minimal-inventory, design D2): de solo agregado, con su variación
// con signo y el saldo resultante. El `INICIAL` es la posición 1; la salida de una factura es única
// por comprobante y producto; la idempotencia de entradas y ajustes tiene alcance empresa,
// operación y clave (CHECK y triggers en la migración).
model StockMovement {
  id                   String              @id @default(uuid())
  companyId            String              @map("company_id")
  productId            String              @map("product_id")
  stock                StockBalance        @relation(fields: [companyId, productId], references: [companyId, productId], onDelete: Restrict)
  position             Int
  /// INICIAL, ENTRADA_MANUAL, SALIDA_FACTURA, DEVOLUCION_NC o AJUSTE.
  movementType         String              @map("movement_type")
  delta                Decimal             @db.Decimal
  balanceAfter         Decimal             @map("balance_after") @db.Decimal
  documentId           String?             @map("document_id")
  document             ElectronicDocument? @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict)
  documentNumber       String?             @map("document_number") @db.Char(17)
  /// USER o SYSTEM.
  origin               String
  actorUserId          String?             @map("actor_user_id")
  actor                User?               @relation("StockMovementActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  /// Motivo del ajuste o nota de la inicialización o de la entrada.
  reason               String?
  /// inventory.entry o inventory.adjust: alcance de la clave junto con la empresa.
  idempotencyOperation String?             @map("idempotency_operation")
  idempotencyKey       String?             @map("idempotency_key") @db.VarChar(100)
  requestHash          String?             @map("request_hash") @db.Char(64)
  occurredAt           DateTime            @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@unique([companyId, productId, position])
  @@unique([companyId, documentId, productId, movementType], map: "stock_movement_document_product_type_key")
  @@unique([companyId, idempotencyOperation, idempotencyKey], map: "stock_movement_idempotency_key")
  @@index([companyId, productId, occurredAt])
  @@map("stock_movement")
}

// Borrador de una nota de crédito (add-credit-notes, design D5): la factura que modifica, la causa,
// el motivo y el punto; sus líneas llevan la cantidad acreditada y el retorno físico. No reserva
// nada: la vista previa se calcula en cada lectura. EMITTED si y solo si tiene su comprobante.
model CreditNoteDraft {
  id              String                @id @default(uuid())
  companyId       String                @map("company_id")
  company         Organization          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoiceId       String                @map("invoice_id")
  invoice         ElectronicDocument    @relation("CreditNoteDraftInvoice", fields: [companyId, invoiceId], references: [companyId, id], onDelete: Restrict)
  emissionPointId String?               @map("emission_point_id")
  emissionPoint   EmissionPoint?        @relation(fields: [companyId, emissionPointId], references: [companyId, id], onDelete: Restrict)
  /// TOTAL_ANNULMENT o RETURN (CHECK en la migración).
  cause           String
  /// Motivo de una sola línea, de 1 a 300 caracteres (`motivo` del XSD); obligatorio al emitir.
  reason          String?
  /// DRAFT o EMITTED (CHECK en la migración).
  status          String                @default("DRAFT")
  documentId      String?               @unique @map("document_id")
  document        ElectronicDocument?   @relation("CreditNoteDraftDocument", fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict)
  version         Int                   @default(1)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String                @map("created_by")
  creator         User                  @relation("CreditNoteDraftCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String                @map("updated_by")
  updater         User                  @relation("CreditNoteDraftUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
  lines           CreditNoteDraftLine[]

  @@unique([companyId, id])
  @@unique([companyId, documentId])
  @@index([companyId, status, updatedAt])
  @@map("credit_note_draft")
}

// Línea de un borrador de nota por la posición de la línea de la factura: la cantidad acreditada y
// el retorno físico declarado, de 0 a lo acreditado (design D5).
model CreditNoteDraftLine {
  draftId        String          @map("draft_id")
  companyId      String          @map("company_id")
  draft          CreditNoteDraft @relation(fields: [companyId, draftId], references: [companyId, id], onDelete: Cascade)
  position       Int
  /// Dominio `cantidad` (18/6); en una anulación total, la cantidad original.
  quantity       Decimal         @db.Decimal
  physicalReturn Decimal         @map("physical_return") @db.Decimal

  @@id([draftId, position])
  @@map("credit_note_draft_line")
}

// Capacidad acreditable de una factura (add-credit-notes, design D7): el total original y lo
// reservado y aplicado por sus notas, que nunca lo superan (CHECK). Nace con la primera nota desde
// el snapshot; el original no cambia. Los totales son siempre la suma de sus reservas por estado
// (trigger diferido en la migración).
model CreditCapacity {
  companyId     String               @map("company_id")
  invoiceId     String               @map("invoice_id")
  invoice       ElectronicDocument   @relation(fields: [companyId, invoiceId], references: [companyId, id], onDelete: Restrict)
  /// Dominio `importe` (14/2), como el total de la factura.
  originalTotal Decimal              @map("original_total") @db.Decimal
  reservedTotal Decimal              @default(0) @map("reserved_total") @db.Decimal
  appliedTotal  Decimal              @default(0) @map("applied_total") @db.Decimal
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  lines         CreditCapacityLine[]
  reservations  CreditReservation[]

  @@id([companyId, invoiceId])
  @@map("credit_capacity")
}

// Capacidad acreditable de una línea de la factura por su posición: la cantidad original y lo
// reservado y aplicado, con el mismo CHECK (design D7).
model CreditCapacityLine {
  companyId        String                  @map("company_id")
  invoiceId        String                  @map("invoice_id")
  capacity         CreditCapacity          @relation(fields: [companyId, invoiceId], references: [companyId, invoiceId], onDelete: Restrict)
  position         Int
  productId        String                  @map("product_id")
  product          Product                 @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Restrict)
  /// Dominio `cantidad` (18/6).
  originalQuantity Decimal                 @map("original_quantity") @db.Decimal
  reservedQuantity Decimal                 @default(0) @map("reserved_quantity") @db.Decimal
  appliedQuantity  Decimal                 @default(0) @map("applied_quantity") @db.Decimal
  reservationLines CreditReservationLine[]

  @@id([companyId, invoiceId, position])
  @@map("credit_capacity_line")
}

// Reserva acreditable de una nota (design D7): una por nota, de solo agregado. Solo pasa de
// RESERVED a APPLIED (nota autorizada) o RELEASED (devuelta o no autorizada), nunca se borra ni se
// reutiliza (triggers en la migración).
model CreditReservation {
  id           String                  @id @default(uuid())
  companyId    String                  @map("company_id")
  invoiceId    String                  @map("invoice_id")
  capacity     CreditCapacity          @relation(fields: [companyId, invoiceId], references: [companyId, invoiceId], onDelete: Restrict)
  creditNoteId String                  @map("credit_note_id")
  creditNote   ElectronicDocument      @relation(fields: [companyId, creditNoteId], references: [companyId, id], onDelete: Restrict)
  /// TOTAL_ANNULMENT o RETURN.
  cause        String
  /// Valor de la modificación de la nota (`importe`).
  amount       Decimal                 @db.Decimal
  /// RESERVED, APPLIED o RELEASED.
  status       String                  @default("RESERVED")
  reservedAt   DateTime                @default(now()) @map("reserved_at") @db.Timestamptz(3)
  concludedAt  DateTime?               @map("concluded_at") @db.Timestamptz(3)
  lines        CreditReservationLine[]

  @@unique([companyId, creditNoteId])
  @@unique([companyId, invoiceId, id])
  @@index([companyId, invoiceId, status])
  @@map("credit_reservation")
}

// Línea acreditada por una nota (design D6 y D7): la cantidad, los importes resultantes del cálculo
// y el retorno físico. Inmutable; es la fuente de lo acreditado vigente de la línea.
model CreditReservationLine {
  reservationId  String             @map("reservation_id")
  companyId      String             @map("company_id")
  invoiceId      String             @map("invoice_id")
  reservation    CreditReservation  @relation(fields: [companyId, invoiceId, reservationId], references: [companyId, invoiceId, id], onDelete: Restrict)
  position       Int
  capacityLine   CreditCapacityLine @relation(fields: [companyId, invoiceId, position], references: [companyId, invoiceId, position], onDelete: Restrict)
  quantity       Decimal            @db.Decimal
  /// Subtotal exacto acreditado (sin redondear).
  subtotal       Decimal            @db.Decimal
  discount       Decimal            @db.Decimal
  taxableBase    Decimal            @map("taxable_base") @db.Decimal
  /// Impuestos acreditados: `[{ taxCode, rateCode, percentage, base, amount }]`.
  taxes          Json
  physicalReturn Decimal            @map("physical_return") @db.Decimal

  @@id([reservationId, position])
  @@map("credit_reservation_line")
}

// Capacidad devolvible de una factura por producto (add-credit-notes, design D10): la salida
// original (el valor absoluto de su SALIDA_FACTURA, o cero sin salida) y lo reservado y aplicado por
// los retornos físicos de sus notas, que nunca la superan (CHECK). Independiente de la acreditable.
model StockReturnCapacity {
  companyId        String                   @map("company_id")
  invoiceId        String                   @map("invoice_id")
  invoice          ElectronicDocument       @relation(fields: [companyId, invoiceId], references: [companyId, id], onDelete: Restrict)
  productId        String                   @map("product_id")
  product          Product                  @relation(fields: [companyId, productId], references: [companyId, id], onDelete: Restrict)
  /// Dominio `existencia` (30/6), no negativo.
  originalQuantity Decimal                  @map("original_quantity") @db.Decimal
  reservedQuantity Decimal                  @default(0) @map("reserved_quantity") @db.Decimal
  appliedQuantity  Decimal                  @default(0) @map("applied_quantity") @db.Decimal
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  reservations     StockReturnReservation[]

  @@id([companyId, invoiceId, productId])
  @@map("stock_return_capacity")
}

// Retorno físico reservado por una nota y producto (design D10), con las guardas de la reserva
// acreditable: solo pasa de RESERVED a APPLIED (con su DEVOLUCION_NC) o RELEASED.
model StockReturnReservation {
  companyId    String              @map("company_id")
  creditNoteId String              @map("credit_note_id")
  creditNote   ElectronicDocument  @relation(fields: [companyId, creditNoteId], references: [companyId, id], onDelete: Restrict)
  productId    String              @map("product_id")
  invoiceId    String              @map("invoice_id")
  capacity     StockReturnCapacity @relation(fields: [companyId, invoiceId, productId], references: [companyId, invoiceId, productId], onDelete: Restrict)
  /// Dominio `existencia`, positivo.
  quantity     Decimal             @db.Decimal
  /// RESERVED, APPLIED o RELEASED.
  status       String              @default("RESERVED")
  reservedAt   DateTime            @default(now()) @map("reserved_at") @db.Timestamptz(3)
  concludedAt  DateTime?           @map("concluded_at") @db.Timestamptz(3)

  @@id([companyId, creditNoteId, productId])
  @@index([companyId, invoiceId, productId, status])
  @@map("stock_return_reservation")
}

// Borrador de una nota de débito (add-debit-notes, design D20 y D26): la factura que modifica, el
// punto y la única forma de pago (una `entryKey` del catálogo `payment-method`); sus conceptos llevan
// la causa, la descripción, el importe y el tratamiento de IVA de la factura. Puede guardarse
// incompleto y no reserva nada. EMITTED si y solo si tiene su comprobante.
model DebitNoteDraft {
  id              String                  @id @default(uuid())
  companyId       String                  @map("company_id")
  company         Organization            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invoiceId       String                  @map("invoice_id")
  invoice         ElectronicDocument      @relation("DebitNoteDraftInvoice", fields: [companyId, invoiceId], references: [companyId, id], onDelete: Restrict)
  emissionPointId String?                 @map("emission_point_id")
  emissionPoint   EmissionPoint?          @relation(fields: [companyId, emissionPointId], references: [companyId, id], onDelete: Restrict)
  /// Clave de la entrada del catálogo `payment-method`; nunca una etiqueta ni un importe.
  paymentMethod   String?                 @map("payment_method")
  /// DRAFT o EMITTED (CHECK en la migración).
  status          String                  @default("DRAFT")
  documentId      String?                 @unique @map("document_id")
  document        ElectronicDocument?     @relation("DebitNoteDraftDocument", fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict)
  version         Int                     @default(1)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String                  @map("created_by")
  creator         User                    @relation("DebitNoteDraftCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String                  @map("updated_by")
  updater         User                    @relation("DebitNoteDraftUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
  concepts        DebitNoteDraftConcept[]

  @@unique([companyId, id])
  @@unique([companyId, documentId])
  @@index([companyId, status, updatedAt])
  @@map("debit_note_draft")
}

// Concepto de un borrador de nota de débito (design D5): cada campo puede faltar mientras se
// prepara; la vista previa informa lo que falta. La causa y la descripción nunca seleccionan otra
// cosa que su propio valor.
model DebitNoteDraftConcept {
  draftId      String         @map("draft_id")
  companyId    String         @map("company_id")
  draft        DebitNoteDraft @relation(fields: [companyId, draftId], references: [companyId, id], onDelete: Cascade)
  position     Int
  /// LATE_PAYMENT_INTEREST o POST_INVOICE_COST_EXPENSE (CHECK en la migración).
  cause        String?
  /// `razon` del XSD: una sola línea de 1 a 300 caracteres.
  description  String?
  /// Dominio `importe` (14/2), mayor que cero.
  amount       Decimal?       @db.Decimal
  /// Clave `taxCode:rateCode` de un tratamiento de IVA de la factura.
  taxTreatment String?        @map("tax_treatment")

  @@id([draftId, position])
  @@map("debit_note_draft_concept")
}

// Factura que modifica una nota de débito (design D26): una por nota e inmutable. Un trigger exige
// una nota 05 y una factura 01 autorizada de la misma empresa y del mismo ambiente, y un trigger
// diferido impide confirmar una nota de débito sin su factura.
model DebitNoteSupport {
  companyId   String             @map("company_id")
  debitNoteId String             @map("debit_note_id")
  debitNote   ElectronicDocument @relation("DebitNoteSupportNote", fields: [companyId, debitNoteId], references: [companyId, id], onDelete: Restrict)
  invoiceId   String             @map("invoice_id")
  invoice     ElectronicDocument @relation("DebitNoteSupportInvoice", fields: [companyId, invoiceId], references: [companyId, id], onDelete: Restrict)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([companyId, debitNoteId])
  @@index([companyId, invoiceId])
  @@map("debit_note_support")
}
