# Copia este archivo a backend/.env para desarrollo. Nunca versiones .env.
NODE_ENV=development
PORT=4000
# Base de desarrollo de compose.yaml. Las pruebas usan facturador_test (DATABASE_URL_TEST).
DATABASE_URL=postgresql://facturador:facturador@127.0.0.1:5432/facturador_dev
DATABASE_URL_TEST=postgresql://facturador:facturador@127.0.0.1:5432/facturador_test
LOG_LEVEL=info
# false sin proxy; un número de proxies de confianza o sus direcciones separadas por comas.
TRUST_PROXY=false
# Better Auth. El secreto de ejemplo solo sirve en desarrollo: la API lo rechaza en producción.
# Genera uno propio con: openssl rand -base64 32
BETTER_AUTH_SECRET=desarrollo-local-solo-para-pruebas-no-usar-en-produccion
# Origen público de la aplicación: el del frontend, que comparte origen con la API (ADR 0016).
BETTER_AUTH_URL=http://localhost:3000
# Administrador inicial: solo se usa en el primer arranque, mientras la instalación no tiene
# empresa. Retira la contraseña del entorno después de ese arranque.
INITIAL_USER_EMAIL=admin@example.com
INITIAL_USER_PASSWORD=cambia-esta-contrasena
# Política de contraseñas y límites de inicio de sesión (defaults de docs/security/hardening.md).
# PASSWORD_MIN_LENGTH=12
# PASSWORD_MAX_LENGTH=128
# LOGIN_MAX_FAILURES=5
# LOGIN_FAILURE_WINDOW_MINUTES=15
# LOGIN_IP_MAX_REQUESTS=30
# LOGIN_IP_WINDOW_SECONDS=60
