# Copia este archivo a backend/.env para desarrollo. Nunca versiones .env.
# Obligatoria, sin valor por defecto: development, test o production.
NODE_ENV=development
PORT=4000
# Base de desarrollo de compose.yaml. Las pruebas usan facturador_test (DATABASE_URL_TEST).
DATABASE_URL=postgresql://facturador:facturador@127.0.0.1:5432/facturador_dev
DATABASE_URL_TEST=postgresql://facturador:facturador@127.0.0.1:5432/facturador_test
LOG_LEVEL=info
# false sin proxy (solo fuera de producción); si no, un número de saltos desde 1, una IP, un CIDR,
# una lista de IP o CIDR separadas por comas, o loopback. En producción es obligatoria.
TRUST_PROXY=false
# Better Auth. El secreto de ejemplo solo sirve en desarrollo: la API lo rechaza en producción.
# Genera uno propio con: openssl rand -base64 32
BETTER_AUTH_SECRET=desarrollo-local-solo-para-pruebas-no-usar-en-produccion
# Origen público de la aplicación: el del frontend, que comparte origen con la API (ADR 0016).
BETTER_AUTH_URL=http://localhost:3000
# Administrador inicial: solo se usa en el primer arranque, mientras la instalación no tiene
# empresa. Retira la contraseña del entorno después de ese arranque.
INITIAL_USER_EMAIL=admin@example.com
INITIAL_USER_PASSWORD=cambia-esta-contrasena
# Política de contraseñas y límites de inicio de sesión (defaults de docs/security/hardening.md).
# PASSWORD_MIN_LENGTH=12
# PASSWORD_MAX_LENGTH=128
# LOGIN_MAX_FAILURES=5
# LOGIN_FAILURE_WINDOW_MINUTES=15
# LOGIN_IP_MAX_REQUESTS=30
# LOGIN_IP_WINDOW_SECONDS=60

# Tamaño máximo del logo de la empresa, en bytes (entre 16384 y 2097152).
# LOGO_MAX_BYTES=524288

# Custodia de la firma electrónica (ADR 0011). La clave maestra son 32 bytes en base64 y nunca va
# a la base de datos; respáldala aparte. La de ejemplo solo sirve en desarrollo: la API la rechaza
# en producción. Genera una propia con: openssl rand -base64 32
# También puede leerse de un archivo con CERTIFICATE_MASTER_KEY_FILE (usa solo una de las dos).
CERTIFICATE_MASTER_KEY=ZGVzYXJyb2xsby1sb2NhbC1uby11c2FyLWVuLXByb2Q=
CERTIFICATE_MASTER_KEY_VERSION=1
# Solo desarrollo y pruebas: CERTIFICATE_CUSTODY=disabled arranca sin firma (prohibido en producción).
# Tamaño máximo del PKCS#12 decodificado, en bytes (entre 8192 y 1048576; 65536 por defecto).
# CERTIFICATE_MAX_BYTES=65536
# Pool criptográfico: workers (1 a 8) y límite por tarea en milisegundos.
# CRYPTO_WORKERS=2
# CRYPTO_TASK_TIMEOUT_MS=30000
# Emisión de facturas: raíz del paquete de XSD (por defecto, docs/product/ en desarrollo y
# dist/xsd/ en el build), validaciones XSD simultáneas (1 a 8), en espera (0 a 256) y plazo en
# milisegundos, y líneas por factura (1 a 1000; defensa de recursos, no un límite del SRI).
# XSD_DIRECTORY=
# XSD_VALIDATION_CONCURRENCY=2
# XSD_VALIDATION_QUEUE=16
# XSD_VALIDATION_TIMEOUT_MS=10000
# INVOICE_MAX_LINES=100
# 1: cabecera Server-Timing con las etapas de la emisión, para bench:emission y el diagnóstico
# local. Prohibida en producción.
# EMISSION_STAGE_TIMINGS=0
# Entrega por correo de los comprobantes autorizados (add-email-delivery). Nace apagada: con 0, el
# sistema no conecta con ningún servidor de correo. El servidor SMTP de cada empresa se configura en
# la aplicación (Configuración → Correos), nunca aquí.
# EMAIL_DELIVERY_ENABLED=0
# Solo el buzón de pruebas del despliegue de revisión (Mailpit): admite un servidor sin cifrado.
# Prohibido en producción.
# EMAIL_ALLOW_PLAINTEXT_SMTP=0
# Plazos del servidor de correo en milisegundos: conexión y saludo (1000 a 120000), e inactividad
# del socket durante el envío (5000 a 300000).
# EMAIL_SMTP_CONNECTION_TIMEOUT_MS=10000
# EMAIL_SMTP_SOCKET_TIMEOUT_MS=60000
# Cola del correo: workers (0 a 4; 0 los desactiva), arriendo en segundos (30 a 3600; cubre los
# plazos anteriores), sondeo en milisegundos e intentos (1 a 50).
# EMAIL_JOB_WORKERS=2
# EMAIL_JOB_LEASE_SECONDS=300
# EMAIL_JOB_POLL_INTERVAL_MS=2000
# EMAIL_JOB_MAX_ATTEMPTS=12
# Reintentos de los fallos temporales: espera base y techo en segundos, y plazo total en horas
# (24 a 168).
# EMAIL_RETRY_BASE_SECONDS=60
# EMAIL_RETRY_CAP_SECONDS=7200
# EMAIL_DELIVERY_DEADLINE_HOURS=26
