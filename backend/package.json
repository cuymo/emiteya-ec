{
  "name": "@facturador/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --conditions=development src/main.ts",
    "build": "tsc -p tsconfig.build.json && node --conditions=development scripts/copy-xsd.ts && node --conditions=development scripts/copy-ride-assets.ts",
    "check:xsd-artifact": "node --conditions=development scripts/check-xsd-artifact.ts",
    "check:ride-assets": "node --conditions=development scripts/check-ride-assets.ts",
    "start": "node dist/main.js",
    "admin:recover": "node --env-file-if-exists=.env --conditions=development src/commands/admin-recover.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run && corepack pnpm test:ac04",
    "test:ac04": "vitest run --config vitest.ac04.config.ts",
    "bench:search": "node --conditions=development scripts/bench-search.ts",
    "bench:emission": "node --conditions=development scripts/bench-emission.ts",
    "bench:ride": "node --conditions=development scripts/bench-ride.ts",
    "bench:inventory": "node --conditions=development scripts/bench-inventory.ts",
    "bench:credit-notes": "node --conditions=development scripts/bench-credit-notes.ts",
    "bench:debit-notes": "node --conditions=development scripts/bench-debit-notes.ts",
    "bench:withholding-receipts": "node --conditions=development scripts/bench-withholding-receipts.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:auth-schema": "auth generate --config src/modules/identity/infrastructure/better-auth/cli.config.ts --output prisma/schema.prisma -y && prisma format",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@better-auth/core": "1.7.7",
    "@facturador/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prometheus-io/client": "0.16.1",
    "better-auth": "1.7.7",
    "bwip-js": "4.11.4",
    "decimal.js": "10.6.0",
    "ec-sri-invoice-signer": "1.8.2",
    "express": "5.2.1",
    "facturacion-electronica-ec": "1.0.1",
    "fast-xml-parser": "5.11.2",
    "fontkit": "2.0.4",
    "helmet": "8.3.0",
    "node-forge": "1.4.0",
    "pdfmake": "0.3.11",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "xmllint-wasm": "5.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.10",
    "@types/express": "5.0.6",
    "@types/node-forge": "1.3.14",
    "@types/supertest": "7.2.1",
    "auth": "1.7.7",
    "pdfjs-dist": "6.3.289",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "zxing-wasm": "3.1.4"
  }
}
